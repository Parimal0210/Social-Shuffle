# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_API_URL: Endpoint URL for the Spring Boot REST Backend API.
# Defaults to https://social-shuffle-backend.onrender.com/api (or http://localhost:8080/api locally)
VITE_BACKEND_API_URL="https://social-shuffle-backend.onrender.com/api"

# VITE_GOOGLE_CLIENT_ID (Temporarily commented out per request)
# VITE_GOOGLE_CLIENT_ID="13280287385-p4ts02igubi7r9cvd2dnkbf5t4d4gbpi.apps.googleusercontent.com"

# --- Outbound Email (SMTP / Gmail Relay) Configuration ---
# Optional: If not provided, an automated Ethereal SMTP test account is used with live preview links.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="socialshuffle.pune@gmail.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD"
SMTP_FROM='"Social Shuffle Pune" <socialshuffle.pune@gmail.com>'

# --- WhatsApp Configuration (Temporarily commented out per request) ---
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Razorpay Payment Gateway Configuration ---
# Key ID provided by Razorpay dashboard (starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID="rzp_test_SocialShufflePune"
RAZORPAY_KEY_ID="rzp_test_SocialShufflePune"
RAZORPAY_KEY_SECRET=""

